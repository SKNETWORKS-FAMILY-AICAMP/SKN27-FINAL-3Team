# Copy this file to .env and fill values locally.
# Never commit real API keys or secrets.

LAW_GO_KR_OC=
OPENAI_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Object storage local development
OBJECT_STORAGE_PROVIDER=mock_s3
OBJECT_STORAGE_BUCKET=skn27-demo-object-storage
OBJECT_STORAGE_PREFIX=canonical
OBJECT_STORAGE_LOCAL_ROOT=backend/media/mock_object_storage
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=

# File scan local policy
FILE_SCAN_PROVIDER=local_policy
FILE_SCAN_CLAMAV_HOST=
FILE_SCAN_CLAMAV_PORT=3310
FILE_SCAN_EXTERNAL_URL=
FILE_SCAN_EXTERNAL_API_KEY=
FILE_SCAN_MAX_BYTES=52428800
FILE_SCAN_REJECT_PII=0
FILE_SCAN_TIMEOUT_SECONDS=10
FILE_SCAN_EXTERNAL_INLINE_MAX_BYTES=5242880

# Supervisor LLM boundary
# Keep this off for deterministic local tests. Set to 1 to call the real API.
SUPERVISOR_LLM_ENABLED=0
SUPERVISOR_LLM_PROVIDER=openai
SUPERVISOR_LLM_MODEL=gpt-5.4-mini
SUPERVISOR_LLM_API_KEY=
SUPERVISOR_LLM_BASE_URL=
SUPERVISOR_LLM_TEMPERATURE=0.1
SUPERVISOR_LLM_TIMEOUT_SECONDS=12

# Legal RAG runtime search
# Keep vector search off until law_chunks/law_embeddings are loaded into PostgreSQL.
LEGAL_RAG_VECTOR_ENABLED=0
LEGAL_RAG_QUERY_EMBEDDING_PROVIDER=sentence-transformers
LEGAL_RAG_QUERY_EMBEDDING_MODEL=intfloat/multilingual-e5-large
LEGAL_RAG_QUERY_EMBEDDING_DIMENSIONS=1024
LEGAL_RAG_QUERY_EMBEDDING_DEVICE=cpu
LEGAL_RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=12
LEGAL_RAG_EMBEDDING_PROVIDER_FILTER=
LEGAL_RAG_OPENAI_API_KEY=

# Neo4j local development
NEO4J_IMAGE=neo4j:5-community
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# PostgreSQL local development
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=law_db

# Agent worker queue
AGENT_WORKER_STALE_AFTER_SECONDS=900
AGENT_WORKER_RETRY_BACKOFF_SECONDS=60
AGENT_WORKER_RETRY_BACKOFF_MAX_SECONDS=900
AGENT_WORKER_LOOP_SLEEP_SECONDS=5
