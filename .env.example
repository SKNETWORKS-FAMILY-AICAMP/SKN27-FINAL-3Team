# Copy this file to .env and fill values locally.
# Never commit real API keys or secrets.

LAW_GO_KR_OC=
OPENAI_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Real Google Authorization Code Flow. Register this exact localhost origin in
# the Google OAuth Web Client before attempting local sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_POPUP_REDIRECT_URI=http://127.0.0.1:5173
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_OAUTH_CODE_EXCHANGE_DAILY_LIMIT=20
# Leave blank unless the app is behind proxies whose CIDRs you explicitly trust.
GOOGLE_OAUTH_TRUSTED_PROXY_CIDRS=
APP_JWT_SECRET=
OAUTH_TOKEN_SECRET=
DJANGO_LOAD_DOTENV=1
DJANGO_ENV_FILE=".env"
VITE_API_PROXY_TARGET=http://127.0.0.1:8010

# Object storage local development
OBJECT_STORAGE_PROVIDER=mock_s3
OBJECT_STORAGE_BUCKET=skn27-demo-object-storage
# Keep unscanned uploads isolated from clean objects, even for mock_s3.
OBJECT_STORAGE_QUARANTINE_BUCKET=skn27-demo-quarantine-storage
OBJECT_STORAGE_PREFIX=canonical
OBJECT_STORAGE_LOCAL_ROOT=backend/media/mock_object_storage
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
FILE_UPLOAD_MAX_BYTES=20971520
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=

# File scan local policy
FILE_SCAN_PROVIDER=local_policy
FILE_SCAN_CLAMAV_HOST=
FILE_SCAN_CLAMAV_PORT=3310
FILE_SCAN_EXTERNAL_URL=
FILE_SCAN_EXTERNAL_API_KEY=
FILE_SCAN_MAX_BYTES=52428800
FILE_SCAN_REJECT_PII=0
FILE_SCAN_TIMEOUT_SECONDS=10
FILE_SCAN_EXTERNAL_INLINE_MAX_BYTES=5242880
FILE_SCAN_CLAIM_STALE_AFTER_SECONDS=300
FILE_SCAN_RETRY_BACKOFF_SECONDS=60
FILE_RETENTION_PURGE_LIMIT=100
FILE_MAX_ATTACHMENTS_PER_REQUEST=20
REPORT_STAGING_CLEANUP_LIMIT=100

# Vision runtime (local subprocess by default)
VISION_RUNTIME_PROVIDER=local
VISION_RUNTIME_TIMEOUT_SECONDS=180
RUNPOD_API_KEY=
RUNPOD_VISION_ENDPOINT_ID=
RUNPOD_VISION_TIMEOUT_SECONDS=600
RUNPOD_VISION_POLL_INTERVAL_SECONDS=2
RUNPOD_VISION_HTTP_TIMEOUT_SECONDS=30
RUNPOD_VISION_MAX_RESPONSE_BYTES=1048576
RUNPOD_VISION_ALLOWED_HOSTS=
RUNPOD_VISION_DOWNLOAD_TIMEOUT_SECONDS=60
RUNPOD_VISION_MAX_DOWNLOAD_BYTES=52428800
RUNPOD_VISION_EXECUTION_TIMEOUT_SECONDS=540

# Supervisor LLM boundary
# Keep this off for deterministic local tests. Set to 1 to call the real API.
SUPERVISOR_LLM_ENABLED=0
SUPERVISOR_LLM_PROVIDER=openai
SUPERVISOR_LLM_MODEL=gpt-5.4-mini
SUPERVISOR_LLM_API_KEY=
SUPERVISOR_LLM_BASE_URL=
SUPERVISOR_LLM_TEMPERATURE=0.1
SUPERVISOR_LLM_TIMEOUT_SECONDS=12

# Legal RAG runtime search
# Keep vector search off until law_chunks/law_embeddings are loaded into PostgreSQL.
LEGAL_RAG_VECTOR_ENABLED=0
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1024
LEGAL_RAG_QUERY_EMBEDDING_PROVIDER=openai
LEGAL_RAG_QUERY_EMBEDDING_MODEL=text-embedding-3-large
LEGAL_RAG_QUERY_EMBEDDING_DIMENSIONS=1024
LEGAL_RAG_QUERY_EMBEDDING_DEVICE=cpu
LEGAL_RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=12
LEGAL_RAG_SEED_EMBEDDING_PROVIDER=openai
LEGAL_RAG_SEED_EMBEDDING_MODEL=text-embedding-3-large
LEGAL_RAG_SEED_EMBEDDING_DIMENSIONS=1024
LEGAL_RAG_OPENAI_API_KEY=
# Non-secret release evidence copied from the validated legal run_summary.
APP_RELEASE_VERSION=local-unversioned
LEGAL_DATASET_VERSION=unconfigured
LEGAL_DATASET_VERIFIED_AT=

# Consultation v2 rollout gates
# Keep every gate off by default. Enable each capability only after its
# offline contract tests and staging dependency checks pass.
CASE_WORKSPACE_V2_ENABLED=0
EVIDENCE_MCP_ENABLED=0
ANONYMOUS_RETENTION_DAYS=1
GUEST_RETENTION_DAYS=7
USER_RETENTION_DAYS=365
RAW_MEDIA_RETENTION_DAYS=30

# Neo4j local development
LAW_GROUND_SEARCH_ENABLE_NEO4J=0
NEO4J_IMAGE=neo4j:5-community
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# PostgreSQL local development
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=law_db

# Agent worker queue
AGENT_WORKER_STALE_AFTER_SECONDS=900
AGENT_WORKER_HEARTBEAT_SECONDS=30
AGENT_WORKER_RETRY_BACKOFF_SECONDS=60
AGENT_WORKER_RETRY_BACKOFF_MAX_SECONDS=900
ANALYSIS_JOB_RESERVATION_STALE_AFTER_SECONDS=300
AGENT_WORKER_LOOP_SLEEP_SECONDS=5

# Privacy-safe operational health snapshots
OPERATIONAL_HEALTH_INTERVAL_SECONDS=60
OPERATIONAL_HEALTH_WINDOW_MINUTES=15
OPERATIONAL_QUEUE_AGE_WARN_SECONDS=300
OPERATIONAL_LEASE_STALE_SECONDS=300
OPERATIONAL_LEGAL_RUN_SUMMARY_PATH=
OPERATIONAL_LEGAL_MAX_AGE_HOURS=168
OPERATIONAL_LEGAL_REQUIRED_SOURCES=
