# Copy this file to .env and fill values locally.
# Never commit real API keys or secrets.

LAW_GO_KR_OC=
OPENAI_API_KEY=

# Neo4j local development
NEO4J_IMAGE=neo4j:5-community
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# PostgreSQL local development
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=law_db

# Fault standard staging can use a separate database inside the same postgres container.
# Create this database first if the postgres volume already exists.
FAULT_STANDARD_POSTGRES_DB=fault_standard_db
