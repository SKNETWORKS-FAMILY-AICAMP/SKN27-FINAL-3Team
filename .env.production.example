# Production environment template.
# Copy to the deployment secret store or runtime environment and replace every
# "replace-with-..." value outside Git. Do not commit real secrets.

# Django runtime
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-django-secret-key-from-secret-manager
DJANGO_ALLOWED_HOSTS=app.example.com,api.example.com
MOCK_REQUIRE_AUTH=1

# PostgreSQL with pgvector
DJANGO_DATABASE_ENGINE=postgres
POSTGRES_IMAGE=pgvector/pgvector:pg16
# Use "postgres" from containers on the docker-compose network.
# Use "localhost" when running backend/manage.py directly on the host with a published Postgres port.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=skn27_app
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=law_db

# Redis progress cache
REDIS_URL=redis://redis:6379/0
PROGRESS_CACHE_TTL_SECONDS=300
AGENT_WORKER_STALE_AFTER_SECONDS=900
AGENT_WORKER_RETRY_BACKOFF_SECONDS=60
AGENT_WORKER_RETRY_BACKOFF_MAX_SECONDS=900
AGENT_WORKER_LOOP_SLEEP_SECONDS=5

# Google Authorization Code Flow
GOOGLE_AUTH_ALLOW_MOCK=0
APP_AUTH_ALLOW_MOCK_BEARER=0
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_POPUP_REDIRECT_URI=https://app.example.com
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
APP_JWT_SECRET=replace-with-app-jwt-secret-from-secret-manager
OAUTH_TOKEN_SECRET=replace-with-oauth-token-secret-from-secret-manager

# Object storage adapter
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=skn27-production-object-storage
OBJECT_STORAGE_PREFIX=canonical
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=ap-northeast-2
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-s3-access-key-id-or-use-iam-role
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key-or-use-iam-role
OBJECT_STORAGE_SESSION_TOKEN=

# File scan policy
FILE_SCAN_PROVIDER=clamav
FILE_SCAN_CLAMAV_HOST=clamav
FILE_SCAN_CLAMAV_PORT=3310
FILE_SCAN_EXTERNAL_URL=
FILE_SCAN_EXTERNAL_API_KEY=
FILE_SCAN_MAX_BYTES=52428800
FILE_SCAN_REJECT_PII=0
FILE_SCAN_TIMEOUT_SECONDS=10
FILE_SCAN_EXTERNAL_INLINE_MAX_BYTES=5242880

# Supervisor LLM planner
SUPERVISOR_LLM_ENABLED=1
SUPERVISOR_LLM_PROVIDER=openai
SUPERVISOR_LLM_MODEL=gpt-5.4-mini
SUPERVISOR_LLM_API_KEY=replace-with-supervisor-llm-api-key
SUPERVISOR_LLM_BASE_URL=
SUPERVISOR_LLM_TEMPERATURE=0.1
SUPERVISOR_LLM_TIMEOUT_SECONDS=12

# Legal RAG runtime search
LEGAL_RAG_VECTOR_ENABLED=1
LEGAL_RAG_QUERY_EMBEDDING_PROVIDER=sentence-transformers
LEGAL_RAG_QUERY_EMBEDDING_MODEL=intfloat/multilingual-e5-large
LEGAL_RAG_QUERY_EMBEDDING_DIMENSIONS=1024
LEGAL_RAG_QUERY_EMBEDDING_DEVICE=cpu
LEGAL_RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=12
LEGAL_RAG_EMBEDDING_PROVIDER_FILTER=
LEGAL_RAG_OPENAI_API_KEY=
LAW_GROUND_SEARCH_ENABLE_NEO4J=0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j

# Fault-ratio text ML Elasticsearch RAG
TEXT_ML_CASE_SEARCH_SYNC_USE_ES=1
TEXT_ML_CASE_SEARCH_ELASTICSEARCH_HOST=http://elasticsearch:9200
TEXT_ML_CASE_SEARCH_ELASTICSEARCH_USER=elastic
TEXT_ML_CASE_SEARCH_ELASTICSEARCH_PASSWORD=replace-with-elasticsearch-password
TEXT_ML_CASE_SEARCH_ELASTICSEARCH_REQUEST_TIMEOUT=120
REVIEW_CASE_ES_BM25_INDEX=review_case_chunks_bm25_nori_v1
FAULT_RATIO_PRECEDENT_ES_BM25_INDEX=precedent_fault_ratio_chunks_bm25_nori_v1

# External ingestion key, if the law ETL is run in this environment.
LAW_GO_KR_OC=replace-with-law-go-kr-open-api-key
OPENAI_API_KEY=
