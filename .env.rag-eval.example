# Local-only legal RAG evaluation. Copy to .env.rag-eval and fill secret values locally.
DJANGO_DATABASE_ENGINE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=law_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

LEGAL_RAG_VECTOR_ENABLED=1
LEGAL_RAG_QUERY_EMBEDDING_PROVIDER=openai
LEGAL_RAG_QUERY_EMBEDDING_MODEL=text-embedding-3-large
LEGAL_RAG_QUERY_EMBEDDING_DIMENSIONS=1024
LEGAL_RAG_SEED_EMBEDDING_PROVIDER=openai
LEGAL_RAG_SEED_EMBEDDING_MODEL=text-embedding-3-large
LEGAL_RAG_SEED_EMBEDDING_DIMENSIONS=1024

# Required for OpenAI query embeddings and --run-ragas.
OPENAI_API_KEY=

# Required only when verified legal JSONL artifacts are absent and a new public-law corpus is collected.
LAW_GO_KR_OC=
LAW_API_KEY=
