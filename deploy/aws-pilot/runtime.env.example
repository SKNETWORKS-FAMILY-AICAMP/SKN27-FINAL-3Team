# Copy this file outside the repository, replace every REPLACE_ value, and pass
# its absolute path to Deploy-Pilot.ps1. The script injects all AWS-generated
# database, bucket, repository, region, release, and app-role secret values.

APP_DOMAIN=pilot.example.org
ACME_EMAIL=owner@example.org
DJANGO_ALLOWED_HOSTS=pilot.example.org,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://pilot.example.org
CSRF_TRUSTED_ORIGINS=https://pilot.example.org

DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
OAUTH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_32_CHARACTER_SECRET

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_POPUP_REDIRECT_URI=https://pilot.example.org
GOOGLE_OAUTH_CODE_EXCHANGE_DAILY_LIMIT=20
# HAProxy is the direct backend peer on the fixed Docker subnet. Never use
# 0.0.0.0/0 here; it would let arbitrary clients spoof X-Forwarded-For.
GOOGLE_OAUTH_TRUSTED_PROXY_CIDRS=172.31.0.3/32

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
SUPERVISOR_LLM_MODEL=gpt-5.4-mini

# t3a.large 파일럿에서도 multilingual-e5-large query embedding은 상주시키지 않는다.
LEGAL_RAG_VECTOR_ENABLED=1
# freshness validation을 통과한 run_summary의 비밀값이 아닌 증적 값이다.
LEGAL_DATASET_VERSION=REPLACE_WITH_VALIDATED_DATASET_VERSION
LEGAL_DATASET_VERIFIED_AT=REPLACE_WITH_VALIDATED_FINISHED_AT
LEGAL_RAG_SEED_MANIFEST_SHA256=INJECTED_BY_DEPLOY_SCRIPT
# Promoted by Maintain-PilotDatabase.ps1 and preserved from the authoritative
# SSM SecureString by Deploy-Pilot.ps1.
PRECEDENT_NEWPLUSPLUS_SEED_VERSION=INJECTED_BY_DATABASE_MAINTENANCE
LAW_GRAPH_REQUIRED=1
NEO4J_URI=bolt://law-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_LAW_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# 개인정보 없는 운영 관측 snapshot. 실제 운영 임계값은 부하 측정 후 승인한다.
OPERATIONAL_HEALTH_INTERVAL_SECONDS=60
OPERATIONAL_HEALTH_WINDOW_MINUTES=15
OPERATIONAL_QUEUE_AGE_WARN_SECONDS=300
OPERATIONAL_LEASE_STALE_SECONDS=300
OPERATIONAL_LEGAL_RUN_SUMMARY_PATH=/run/operational-evidence/run_summary.json
OPERATIONAL_LEGAL_MAX_AGE_HOURS=168
OPERATIONAL_LEGAL_REQUIRED_SOURCES=

FILE_UPLOAD_MAX_BYTES=20971520
FILE_SCAN_MAX_BYTES=52428800

# RunPod Serverless Vision. Keep the key, endpoint ID, and approved S3 host
# values in the private runtime file only.
VISION_RUNTIME_PROVIDER=runpod
VISION_RUNTIME_TIMEOUT_SECONDS=180
RUNPOD_API_KEY=
RUNPOD_VISION_ENDPOINT_ID=
RUNPOD_VISION_TIMEOUT_SECONDS=600
RUNPOD_VISION_POLL_INTERVAL_SECONDS=2
RUNPOD_VISION_HTTP_TIMEOUT_SECONDS=30
RUNPOD_VISION_MAX_RESPONSE_BYTES=1048576
RUNPOD_VISION_ALLOWED_HOSTS=
RUNPOD_VISION_DOWNLOAD_TIMEOUT_SECONDS=60
RUNPOD_VISION_MAX_DOWNLOAD_BYTES=52428800
RUNPOD_VISION_EXECUTION_TIMEOUT_SECONDS=540

# Optional private AWS GPU Vision queue. Keep VISION_RUNTIME_PROVIDER=runpod
# unless the disabled-by-default Vision worker stack has been approved and applied.
AWS_VISION_QUEUE_URL=
AWS_VISION_RESULT_BUCKET=
AWS_VISION_RESULT_PREFIX=vision/aws-queue/v1
AWS_VISION_TIMEOUT_SECONDS=900
AWS_VISION_POLL_INTERVAL_SECONDS=2

# Replace a tag with an immutable name@sha256:digest after reviewing the
# upstream image. These explicit hooks avoid editing Compose for a digest pin.
CADDY_IMAGE_REF=REPLACE_WITH_REVIEWED_CADDY_IMAGE_AT_SHA256
HAPROXY_IMAGE_REF=REPLACE_WITH_REVIEWED_HAPROXY_IMAGE_AT_SHA256
REDIS_IMAGE_REF=REPLACE_WITH_REVIEWED_REDIS_IMAGE_AT_SHA256
CLAMAV_IMAGE_REF=REPLACE_WITH_REVIEWED_CLAMAV_IMAGE_AT_SHA256
NGINX_IMAGE_REF=REPLACE_WITH_REVIEWED_NGINX_IMAGE_AT_SHA256
POSTGRES_MAINTENANCE_IMAGE_REF=postgres:16.14-alpine3.24@sha256:REPLACE_WITH_REVIEWED_POSTGRES_MANIFEST_DIGEST
LAW_NEO4J_IMAGE_REF=REPLACE_WITH_REVIEWED_NEO4J_IMAGE_AT_SHA256

# The following values are overwritten from Terraform/RDS outputs. They are
# visible here only to make the final runtime contract auditable.
POSTGRES_HOST=INJECTED_BY_DEPLOY_SCRIPT
POSTGRES_PORT=5432
POSTGRES_USER=INJECTED_BY_DEPLOY_SCRIPT
POSTGRES_PASSWORD=INJECTED_FROM_APP_DATABASE_SECRET
POSTGRES_DB=INJECTED_BY_DEPLOY_SCRIPT
REVIEW_CASE_DB=law_db
AWS_REGION=INJECTED_BY_DEPLOY_SCRIPT
AWS_DEFAULT_REGION=INJECTED_BY_DEPLOY_SCRIPT
OPERATIONAL_LOG_GROUP=INJECTED_BY_DEPLOY_SCRIPT
OBJECT_STORAGE_REGION=INJECTED_BY_DEPLOY_SCRIPT
OBJECT_STORAGE_BUCKET=INJECTED_BY_DEPLOY_SCRIPT
OBJECT_STORAGE_QUARANTINE_BUCKET=INJECTED_BY_DEPLOY_SCRIPT
BACKEND_REPOSITORY_URL=INJECTED_BY_DEPLOY_SCRIPT
FRONTEND_REPOSITORY_URL=INJECTED_BY_DEPLOY_SCRIPT
RELEASE_TAG=INJECTED_BY_DEPLOY_SCRIPT
