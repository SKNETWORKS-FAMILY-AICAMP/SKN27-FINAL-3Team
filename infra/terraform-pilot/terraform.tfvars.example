budget_alert_email = "owner@example.org"
budget_limit_usd   = 50

# AWS Free plan accounts can use this x86 8 GiB instance in Seoul and require
# one-day RDS automated backup retention. Paid plans may keep the defaults.
# instance_type                    = "m7i-flex.large"
# database_backup_retention_days   = 1

# Keep database_deletion_protection enabled except during an approved teardown.
database_deletion_protection = true

# Narrow these CIDRs for an internal pilot. A public customer pilot normally
# keeps 80/443 open and relies on TLS plus the HAProxy/app rate gates.
http_ingress_cidrs = ["0.0.0.0/0"]

# Optional. Keep empty until an operator chooses a private alert recipient.
# AWS sends a one-time SNS confirmation email when this is set.
operational_alert_email = ""

# Provisional pilot values. Replace only after reviewing actual load evidence.
operational_queue_age_threshold_seconds      = 300
operational_stale_running_threshold_count    = 0
operational_worker_failure_threshold_count   = 0
operational_provider_failure_threshold_count = 0
operational_legal_failure_threshold_count    = 0
operational_heartbeat_missing_periods        = 3
