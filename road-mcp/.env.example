#-----------------------------------------------------------------------------#
# Road Environment MCP
#-----------------------------------------------------------------------------#

ROAD_MCP_HOST=0.0.0.0
ROAD_MCP_PORT=8001
ROAD_MCP_TRANSPORT=stdio
ROAD_LOG_LEVEL=INFO

#-----------------------------------------------------------------------------#
# VWorld
#-----------------------------------------------------------------------------#

VWORLD_API_KEY=
VWORLD_SEARCH_URL=https://api.vworld.kr/req/search
VWORLD_REQUEST_TIMEOUT_SECONDS=10

#-----------------------------------------------------------------------------#
# Road PostGIS
#-----------------------------------------------------------------------------#

# Local direct execution can use localhost and the published docker port.
# Inside docker compose, use ROAD_DB_HOST=road-postgis and ROAD_DB_PORT=5432.
ROAD_DB_HOST=localhost
ROAD_DB_PORT=5433
ROAD_DB_NAME=road_environment
ROAD_DB_USER=road_user
ROAD_DB_PASSWORD=change-me

#-----------------------------------------------------------------------------#
# Data loading
#-----------------------------------------------------------------------------#

ROAD_DATA_DIR=./data
OSM_PBF_URL=https://download.geofabrik.de/asia/south-korea-latest.osm.pbf

# Use the Decoding service key from data.go.kr Swagger/OpenAPI screens.
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_DEFAULT_NUM_OF_ROWS=100
PUBLIC_DATA_REQUEST_TIMEOUT_SECONDS=30

# Fill these after checking each data.go.kr Swagger screen.
ROAD_SIGNS_API_URL=
TRAFFIC_SIGNALS_API_URL=
CROSSWALKS_API_URL=
PROTECTION_ZONES_API_URL=https://apis.data.go.kr/1320000/safetyzonedtlinfo/getdtllist

# Protection zone API requires sggCd. Fill comma-separated city/county/district codes.
# Example: PROTECTION_ZONE_SGG_CODES=11110,11140
PROTECTION_ZONE_SGG_CODES=
PROTECTION_ZONE_SGG_CODES_CSV=./data/raw/reference/sgg_codes.csv
PROTECTION_ZONE_ASSIGN_TYPE=
PROTECTION_ZONE_CALL_DATE=
