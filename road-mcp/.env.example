#-----------------------------------------------------------------------------#
# Road Environment MCP
#-----------------------------------------------------------------------------#

ROAD_MCP_HOST=0.0.0.0
ROAD_MCP_PORT=8001
ROAD_MCP_TRANSPORT=stdio
ROAD_LOG_LEVEL=INFO

#-----------------------------------------------------------------------------#
# VWorld
#-----------------------------------------------------------------------------#

VWORLD_API_KEY=
VWORLD_SEARCH_URL=https://api.vworld.kr/req/search
VWORLD_REQUEST_TIMEOUT_SECONDS=10

#-----------------------------------------------------------------------------#
# Road PostGIS
#-----------------------------------------------------------------------------#

# Local direct execution can use localhost and the published docker port.
# Inside docker compose, use ROAD_DB_HOST=road-postgis and ROAD_DB_PORT=5432.
ROAD_DB_HOST=localhost
ROAD_DB_PORT=5433
ROAD_DB_NAME=road_environment
ROAD_DB_USER=road_user
ROAD_DB_PASSWORD=change-me

#-----------------------------------------------------------------------------#
# Data loading
#-----------------------------------------------------------------------------#

ROAD_DATA_DIR=./data
OSM_PBF_URL=https://download.geofabrik.de/asia/south-korea-latest.osm.pbf
PUBLIC_DATA_API_KEY=
